generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("editor")
  company       String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Project {
  id            String   @id @default(uuid())
  name          String
  number        String
  buildingType  String   @default("")
  grossArea     Float    @default(0)
  estimatedCost Float    @default(0)
  orgId         String?
  createdBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId])
  planFiles     PlanFile[]
  bimModels     BimModel[]
  schedules     Schedule[]
  boqs          Boq[]
  rfis             Rfi[]
  punchListItems   PunchListItem[]
  changeOrders     ChangeOrder[]
  purchaseOrders   PurchaseOrder[]
  submittals       Submittal[]
  bidRequests      BidRequest[]
  expenses         Expense[]
  takeoffs         Takeoff[]
  dailyLogs        DailyLog[]
  equipment        Equipment[]
  timeEntries      TimeEntry[]
  lookaheadTasks   LookaheadTask[]
  weeklyWorkPlans  WeeklyWorkPlan[]
  pullPlanCards    PullPlanCard[]
  invoices         Invoice[]
  structuralDesigns StructuralDesign[]
  safetyIncidents  SafetyIncident[]
  toolboxTalks     ToolboxTalk[]
  inspections      Inspection[]
  nonConformances  NonConformance[]
  complianceReqs   ComplianceRequirement[]
  risks            Risk[]
  correspondence   Correspondence[]
  transmittals     Transmittal[]
  costMatches      CostMatch[]
}

model PlanFile {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  filePath    String
  fileType    String   @default("image")
  sheetNumber String   @default("")
  discipline  String   @default("Architectural")
  revision    String   @default("0")
  setName     String   @default("Current")
  scale       Float    @default(100)
  analysis    String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Classification {
  id          String   @id @default(uuid())
  name        String
  category    String   @default("area")
  color       String   @default("rgba(59,130,246,0.25)")
  costCode    String   @default("")
  unitRate    Float    @default(0)
  unit        String   @default("SF")
  companyWide Boolean  @default(true)
  projectId   String   @default("")
  createdAt   DateTime @default(now())
}

model Assembly {
  id          String   @id @default(uuid())
  name        String
  category    String   @default("wall")
  unit        String   @default("SF")
  description String   @default("")
  components  String   @default("[]")
  totalCost   Float    @default(0)
  companyWide Boolean  @default(true)
  projectId   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SharedModel {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  filePath    String
  shareToken  String   @unique
  viewCount   Int      @default(0)
  createdBy   String   @default("")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── 4D Construction Simulation ─────────────────────────────

model BimModel {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  discipline  String       @default("Architectural")
  filePath    String
  fileSizeMb  Float        @default(0)
  elementCount Int         @default(0)
  uploadedAt  DateTime     @default(now())
  elements    BimElement[]
}

model BimElement {
  id          String       @id @default(uuid())
  modelId     String
  model       BimModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  globalId    String
  ifcClass    String       @default("")
  name        String       @default("")
  levelName   String       @default("")
  material    String       @default("")
  volume      Float        @default(0)
  area        Float        @default(0)
  properties  String       @default("{}")
  taskLinks   TaskElementLink[]

  @@unique([modelId, globalId])
}

model Schedule {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  sourceFormat String     @default("excel")
  version      Int        @default(1)
  importedAt   DateTime   @default(now())
  tasks        Task[]
}

model Task {
  id              String       @id @default(uuid())
  scheduleId      String
  schedule        Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  externalId      String       @default("")
  wbsCode         String       @default("")
  name            String
  taskType        String       @default("task")
  startDate       DateTime
  endDate         DateTime
  durationDays    Float        @default(0)
  percentComplete Float        @default(0)
  parentTaskId    String?
  sortOrder       Int          @default(0)
  costBudget      Float        @default(0)
  costActual      Float        @default(0)
  elementLinks    TaskElementLink[]
  predecessors    TaskDependency[] @relation("successor")
  successors      TaskDependency[] @relation("predecessor")
}

model TaskDependency {
  id             String   @id @default(uuid())
  predecessorId  String
  predecessor    Task     @relation("predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId    String
  successor      Task     @relation("successor", fields: [successorId], references: [id], onDelete: Cascade)
  depType        String   @default("FS")
  lagDays        Float    @default(0)

  @@unique([predecessorId, successorId])
}

model TaskElementLink {
  id          String     @id @default(uuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  elementId   String
  element     BimElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  action      String     @default("construct")
  createdBy   String     @default("manual")

  @@unique([taskId, elementId])
}

model DailyLog {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  taskId      String?
  description String   @default("")
  progress    Float    @default(0)
  weather     String   @default("")
  crew        Int      @default(0)
  notes       String   @default("")
  photos      String   @default("[]")              // JSON array of {url, gpsLat?, gpsLng?, takenAt?}
  gpsLat      Float?
  gpsLng      Float?
  orgId       String?
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, date])
}

model Equipment {
  id              String    @id @default(uuid())
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name            String
  type            String    @default("rental")                       // owned | rental | subcontracted
  category        String    @default("general")                      // formwork | scaffold | crane | mixer | compactor | tool | vehicle | general
  serialNumber    String    @default("")
  rentalCompany   String    @default("")
  rentalRateDaily Decimal   @default(0) @db.Decimal(18, 2)
  currency        String    @default("CRC")
  startDate       DateTime?
  endDate         DateTime?
  status          String    @default("idle")                         // idle | active | maintenance | returned | retired
  assignedTo      String    @default("")
  notes           String    @default("")
  orgId           String?
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId, status])
}

model TimeEntry {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerName      String
  workerRole      String    @default("oficial")                      // operario_especializado | operario | ayudante | peon | maestro | ingeniero | otro
  taskDescription String    @default("")
  date            DateTime
  hours           Float     @default(0)
  hourlyRate      Decimal   @default(0) @db.Decimal(18, 2)
  totalCost       Decimal   @default(0) @db.Decimal(18, 2)           // server-computed: hours * hourlyRate
  currency        String    @default("CRC")
  positionId      String?
  notes           String    @default("")
  approved        Boolean   @default(false)
  approvedBy      String    @default("")
  orgId           String?
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId, date])
  @@index([positionId])
}

// ─── Bill of Quantities (detailed estimate) ──────────────────

model Boq {
  id            String         @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String         @default("")
  status        String         @default("draft") // draft | sent | approved | rejected
  currency      String         @default("CRC")
  orgId         String?
  createdBy     String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  positions     BoqPosition[]
  markups       BoqMarkup[]
}

model BoqPosition {
  id              String   @id @default(uuid())
  boqId           String
  boq             Boq      @relation(fields: [boqId], references: [id], onDelete: Cascade)
  ordinal         String   @default("")          // e.g. "01.02.003"
  description     String
  unit            String   @default("unidad")    // m, m2, m3, kg, pcs, lsum, …
  quantity        Decimal  @default(0) @db.Decimal(18, 4)
  unitRate        Decimal  @default(0) @db.Decimal(18, 2)
  total           Decimal  @default(0) @db.Decimal(18, 2)  // denormalized; computed on write
  source          String   @default("manual")    // manual | cad_import | catalog
  cadElementIds   String   @default("[]")        // JSON array of IFC globalIds
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([boqId, sortOrder])
}

model BoqMarkup {
  id            String   @id @default(uuid())
  boqId         String
  boq           Boq      @relation(fields: [boqId], references: [id], onDelete: Cascade)
  name          String
  markupType    String   @default("percentage") // percentage | fixed
  category      String   @default("overhead")   // overhead | profit | tax | contingency
  percentage    Decimal  @default(0) @db.Decimal(8, 4)
  fixedAmount   Decimal  @default(0) @db.Decimal(18, 2)
  applyTo       String   @default("direct_cost") // direct_cost | cumulative
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([boqId, sortOrder])
}

// ─── Execution: RFI, Punch list, Change orders ──────────────

model Rfi {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String   @default("")          // e.g. "RFI-001"
  subject     String
  question    String   @default("")
  answer      String   @default("")
  discipline  String   @default("general")   // architectural | structural | mep | civil | general
  status      String   @default("open")      // open | answered | closed
  priority    String   @default("normal")    // low | normal | high | urgent
  dueDate     DateTime?
  askedBy     String   @default("")
  answeredBy  String   @default("")
  orgId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
}

model PunchListItem {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String   @default("")          // e.g. "P-001"
  description String
  location    String   @default("")          // e.g. "Level 2, Room 203"
  trade       String   @default("general")   // electrical | plumbing | finishes | etc.
  status      String   @default("open")      // open | in_progress | resolved | verified
  severity    String   @default("normal")    // minor | normal | major | critical
  assignedTo  String   @default("")
  photos      String   @default("[]")        // JSON array of URLs
  orgId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
}

model ChangeOrder {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String   @default("")          // e.g. "CO-001"
  title       String
  description String   @default("")
  reason      String   @default("")          // owner_request | design_change | site_condition | regulatory
  costImpact  Decimal  @default(0) @db.Decimal(18, 2)   // derived: directSubtotal + markupsTotal
  directSubtotal Decimal @default(0) @db.Decimal(18, 2) // sum of line items (material+labor+equipment+sub+other)
  markupsTotal   Decimal @default(0) @db.Decimal(18, 2) // sum of all active markups applied
  currency       String  @default("CRC")
  scheduleImpactDays Int @default(0)
  scheduleJustification String @default("")
  status      String   @default("draft")     // draft | submitted | approved | rejected
  submittedBy String   @default("")
  approvedBy  String   @default("")
  approvedAt  DateTime?
  orgId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems   ChangeOrderLineItem[]
  markups     ChangeOrderMarkup[]
  versions    ChangeOrderVersion[]

  @@index([projectId, status])
}

model ChangeOrderLineItem {
  id              String      @id @default(uuid())
  changeOrderId   String
  changeOrder     ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  ordinal         String      @default("")     // e.g. "1.1", "1.2", "2.1"
  description     String
  category        String      @default("materials") // materials | labor | equipment | subcontractor | other
  unit            String      @default("unidad") // m, m2, m3, kg, hr, pcs, lsum…
  quantity        Decimal     @default(0) @db.Decimal(18, 4)
  unitRate        Decimal     @default(0) @db.Decimal(18, 2)
  subtotal        Decimal     @default(0) @db.Decimal(18, 2) // server-computed quantity*unitRate
  notes           String      @default("")
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([changeOrderId, sortOrder])
}

model ChangeOrderMarkup {
  id              String      @id @default(uuid())
  changeOrderId   String
  changeOrder     ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  name            String                                       // e.g. "Overhead 10%", "Profit 8%", "Contingencia"
  category        String      @default("overhead")             // overhead | profit | tax | contingency
  markupType      String      @default("percentage")           // percentage | fixed
  percentage      Decimal     @default(0) @db.Decimal(8, 4)    // 10.0000 = 10%
  fixedAmount     Decimal     @default(0) @db.Decimal(18, 2)
  applyTo         String      @default("subtotal")             // subtotal | cumulative
  computedAmount  Decimal     @default(0) @db.Decimal(18, 2)   // server-computed
  sortOrder       Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([changeOrderId, sortOrder])
}

model ChangeOrderVersion {
  id              String      @id @default(uuid())
  changeOrderId   String
  changeOrder     ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  versionNumber   Int                                           // monotonically increasing per CO
  status          String                                        // status at snapshot time
  snapshotJson    String                                        // full CO + line items + markups serialized
  changeNote      String      @default("")                      // why this version exists ("Submitted to owner")
  createdBy       String      @default("")
  createdAt       DateTime    @default(now())

  @@unique([changeOrderId, versionNumber])
  @@index([changeOrderId])
}

// ─── Mawi Parity Modules ─────────────────────────────────────

model PurchaseOrder {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       String    @default("")
  supplier     String    @default("")
  description  String    @default("")
  status       String    @default("draft")    // draft | issued | partially_received | received | paid | cancelled
  totalAmount  Decimal   @default(0) @db.Decimal(18, 2)
  currency     String    @default("CRC")
  issueDate    DateTime?
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String    @default("")
  orgId        String?
  createdBy    String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, status])
}

model Submittal {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       String    @default("")
  title        String
  description  String    @default("")
  type         String    @default("shop_drawing")  // shop_drawing | sample | product_data | mock_up | calculations
  spec_section String    @default("")
  status       String    @default("draft")  // draft | submitted | under_review | approved | rejected | revise_resubmit
  submittedBy  String    @default("")
  reviewedBy   String    @default("")
  submittedAt  DateTime?
  reviewedAt   DateTime?
  notes        String    @default("")
  orgId        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, status])
}

model BidRequest {
  id               String    @id @default(uuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number           String    @default("")
  scope            String
  description      String    @default("")
  dueDate          DateTime?
  status           String    @default("open")   // open | closed | awarded | cancelled
  invitedSuppliers String    @default("[]")
  awardedSupplier  String    @default("")
  awardedAmount    Decimal   @default(0) @db.Decimal(18, 2)
  currency         String    @default("CRC")
  notes            String    @default("")
  orgId            String?
  createdBy        String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bidQuotes        BidQuote[]

  @@index([projectId, status])
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  category      String   @default("")
  contactName   String   @default("")
  contactEmail  String   @default("")
  contactPhone  String   @default("")
  taxId         String   @default("")
  address       String   @default("")
  paymentTerms  String   @default("contado")
  rating        Int      @default(0)
  notes         String   @default("")
  isActive      Boolean  @default(true)
  orgId         String?
  createdBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bidQuotes     BidQuote[]

  @@index([createdBy, isActive])
  @@index([orgId, isActive])
}

model BidQuote {
  id            String      @id @default(uuid())
  bidRequestId  String
  bidRequest    BidRequest  @relation(fields: [bidRequestId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName  String      @default("")
  amount        Decimal     @default(0) @db.Decimal(18, 2)
  currency      String      @default("CRC")
  validUntil    DateTime?
  notes         String      @default("")
  status        String      @default("pending")
  receivedAt    DateTime?
  documents     String      @default("[]")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([bidRequestId])
  @@index([supplierId])
}

model Expense {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  positionId    String?
  number        String    @default("")
  vendor        String    @default("")
  description   String
  category      String    @default("materials")  // materials | labor | equipment | subcontractor | overhead | other
  amount        Decimal   @default(0) @db.Decimal(18, 2)
  currency      String    @default("CRC")
  invoiceDate   DateTime?
  paymentDate   DateTime?
  status        String    @default("pending")  // pending | approved | paid | rejected
  attachmentUrl String    @default("")
  // ── CR Tax fields ────────────────────────────────────────────
  taxRate           Float    @default(13)
  taxAmount         Decimal  @default(0) @db.Decimal(18, 2)
  withholdingRate   Float    @default(0)
  withholdingAmount Decimal  @default(0) @db.Decimal(18, 2)
  withholdingType   String   @default("")   // "iva_2pct" | "renta_2pct" | "renta_4pct"
  orgId         String?
  createdBy     String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, status])
  @@index([positionId])
}

// ─── PDF Takeoff (Plan 8a) ────────────────────────────────────

model Takeoff {
  id            String                @id @default(uuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String                                                    // e.g. "A-100 Plantas Arq."
  pdfUrl        String                @default("")                        // path to uploaded PDF
  pageNumber    Int                   @default(1)
  scaleFactor   Float                 @default(1.0)                       // pixels-per-meter; computed from calibration
  scaleUnit     String                @default("m")                       // m | ft | in | mm
  calibrated    Boolean               @default(false)
  notes         String                @default("")
  orgId         String?
  createdBy     String                @default("")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  measurements  TakeoffMeasurement[]

  @@index([projectId])
}

model TakeoffMeasurement {
  id               String   @id @default(uuid())
  takeoffId        String
  takeoff          Takeoff  @relation(fields: [takeoffId], references: [id], onDelete: Cascade)
  type             String                            // "area" | "length" | "count"
  label            String   @default("")             // e.g. "Walls level 1", "Doors"
  unit             String   @default("m2")           // m2 | m | unidad
  quantity         Float    @default(0)              // computed value in target units
  geometryJson     String   @default("[]")           // JSON array of points
  color            String   @default("#a78bfa")      // overlay color
  catalogProductId String?                           // optional link to catalog product
  unitRate         Float    @default(0)              // for BOQ push
  createdAt        DateTime @default(now())

  @@index([takeoffId])
}

// ─── Audit Log ───────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  userEmail   String   @default("")
  action      String                            // "create" | "update" | "delete"
  entityType  String                            // "Boq" | "PurchaseOrder" | etc
  entityId    String
  projectId   String?                           // optional, for project-level filtering
  orgId       String?
  changes     String   @default("{}")           // JSON snapshot of {before, after} for update; full record for create/delete
  description String   @default("")             // human-readable summary
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

// ─── Outbuild-style Lookahead + Weekly Plan + Pull Planning ─────

model LookaheadTask {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTaskId    String?
  name            String
  description     String   @default("")
  weekOf          DateTime
  startDate       DateTime
  endDate         DateTime
  durationDays    Float    @default(1)
  assignedCrew    String   @default("")
  trade           String   @default("general")
  constraints     String   @default("[]")
  status          String   @default("planned")
  percentComplete Float    @default(0)
  notes           String   @default("")
  sortOrder       Int      @default(0)
  orgId           String?
  createdBy       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  weeklyPlanItem  WeeklyPlanItem?

  @@index([projectId, weekOf])
}

model WeeklyWorkPlan {
  id          String           @id @default(uuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekOf      DateTime
  status      String           @default("draft")
  notes       String           @default("")
  orgId       String?
  createdBy   String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items       WeeklyPlanItem[]

  @@unique([projectId, weekOf])
  @@index([projectId])
}

model WeeklyPlanItem {
  id              String         @id @default(uuid())
  weeklyPlanId    String
  weeklyPlan      WeeklyWorkPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
