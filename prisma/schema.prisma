// ─── Sprint 1: Cost Benchmarks (CR data, replaces hardcoded US rates) ──────────

/// Per-building-type baseline cost rates in CRC/m². Used by /api/estimate
/// for conceptual estimates grounded in real CR data.
model CostBenchmark {
  id                 String   @id @default(uuid())
  buildingType       String
  finishLevel        String   @default("standard")
  constructionSystem String   @default("MAMPOSTERIA_CONFINADA")
  ratePerSqm         Decimal  @default(0) @db.Decimal(18, 2)
  currency           String   @default("CRC")
  region             String   @default("CR_NATIONAL")
  source             String   @default("")
  effectiveDate      DateTime @default(now())
  notes              String   @default("")
  divisionsJson      String   @default("{}")
  matLaborJson       String   @default("{}")
  orgId              String?
  createdBy          String   @default("")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([buildingType, finishLevel, constructionSystem, region, orgId])
  @@index([buildingType, constructionSystem, isActive])
}

/// Per-organization subscription tier + add-ons. Stripe metadata lives here
/// once Phase C wires billing; for now the row is the source of truth.
///
/// Plan values: FREE | ESTIMATING | PRO | BIM_SUITE | ENTERPRISE
/// PriceMode:   PER_PROJECT (Estimating) | PER_SEAT (Pro / BIM Suite / Enterprise)
/// AddOns (CSV string): COSTAPLANNER_PRO,WHATSAPP_PRO,IOS_ANDROID,PDF_MARKUPS,BCF
/// Status:      ACTIVE | TRIALING | PAST_DUE | CANCELED | INCOMPLETE
model Subscription {
  id                   String   @id @default(uuid())
  orgId                String   @unique
  plan                 String   @default("FREE")
  priceMode            String   @default("PER_SEAT")
  status               String   @default("ACTIVE")
  addons               String   @default("")
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  seatsPurchased       Int      @default(1)
  stripeCustomerId     String   @default("")
  stripeSubscriptionId String   @default("")
  notes                String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([plan, status])
  @@index([stripeCustomerId])
}

/// Per-org monthly usage counters. Reset on currentPeriodEnd or first-of-month.
/// Used to enforce quota-limited features (OCR pages, AI tokens, exports, active projects).
model Quota {
  id                 String   @id @default(uuid())
  orgId              String
  periodStart        DateTime @default(now())
  exportsUsed        Int      @default(0)
  ocrPagesUsed       Int      @default(0)
  aiTokensUsed       Int      @default(0)
  activeProjectCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([orgId, periodStart])
  @@index([orgId])
}

/// CR construction resource catalog (cement, rebar, blocks, labor rates).
model ResourceBenchmark {
  id            String   @id @default(uuid())
  code          String
  name          String
  resourceType  String   @default("material")
  category      String   @default("")
  unit          String
  priceAvg      Decimal  @default(0) @db.Decimal(18, 2)
  priceMin      Decimal  @default(0) @db.Decimal(18, 2)
  priceMax      Decimal  @default(0) @db.Decimal(18, 2)
  currency      String   @default("CRC")
  source        String   @default("")
  effectiveDate DateTime @default(now())
  notes         String   @default("")
  orgId         String?
  createdBy     String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([code, orgId])
  @@index([resourceType, isActive])
  @@index([category])
}

