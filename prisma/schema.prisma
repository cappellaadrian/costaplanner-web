// ─── Multi-tenant teams ─────────────────────────────────────

model Organization {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  ownerUserId   String                                  // initial creator; becomes the "owner" role member
  taxId         String           @default("")           // CR cédula jurídica if set
  logoUrl       String           @default("")
  isPersonal    Boolean          @default(false)        // true for the auto-created default org per user
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  memberships   OrgMembership[]
  invites       OrgInvite[]

  @@index([ownerUserId])
}

model OrgMembership {
  id            String       @id @default(uuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId        String
  role          String       @default("viewer")        // owner | pm | field | viewer | subcontractor
  invitedAt     DateTime     @default(now())
  joinedAt      DateTime?
  status        String       @default("active")         // active | suspended | left

  @@unique([orgId, userId])
  @@index([userId])
}

model OrgInvite {
  id            String       @id @default(uuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email         String
  role          String       @default("viewer")
  token         String       @unique @default(uuid())
  invitedBy     String
  expiresAt     DateTime
  acceptedAt    DateTime?
  status        String       @default("pending")       // pending | accepted | expired | revoked
  createdAt     DateTime     @default(now())

  @@index([orgId, status])
  @@index([token])
}

model SubcontractorPortalAccess {
  id            String   @id @default(uuid())
  orgId         String
  supplierId    String?                                // optional link to Supplier
  email         String
  contactName   String   @default("")
  token         String   @unique @default(uuid())
  scope         String   @default("default")           // "default" | custom JSON
  expiresAt     DateTime?
  lastAccessedAt DateTime?
  active        Boolean  @default(true)
  createdBy     String   @default("")
  createdAt     DateTime @default(now())

  @@index([token])
  @@index([orgId, active])
}

// ─── Marketing leads (Plan 8h) ───────────────────────────────

model Lead {
