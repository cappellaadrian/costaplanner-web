// ─── Sprint 3: Compliance (CFIA, Min Salud, Bomberos, Setena, Municipalidad) ────

// ─── Sprint 4: Risk register (PMBOK-style) ──────────────────────────────────────
model Risk {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number          String    @default("")
  title           String
  description     String    @default("")
  category        String    @default("schedule")             // schedule | cost | quality | safety | regulatory | external | resource
  probability     Int       @default(3)                      // 1-5 (very low to very high)
  impact          Int       @default(3)                      // 1-5
  score           Int       @default(9)                      // probability * impact (server-computed)
  mitigation      String    @default("")
  contingency     String    @default("")
  responsibleParty String   @default("")
  triggerDate     DateTime?
  status          String    @default("open")                 // open | monitoring | mitigated | accepted | realized | closed
  costExposure    Decimal   @default(0) @db.Decimal(18, 2)
  scheduleExposureDays Int  @default(0)
  realizedDate    DateTime?
  closedAt        DateTime?
  notes           String    @default("")
  orgId           String?
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId, status])
  @@index([projectId, score])
}

// ─── Sprint 5: Correspondence log (formal letters/emails) ───────────────────────
model Correspondence {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number          String    @default("")
  date            DateTime
  direction       String    @default("outbound")             // inbound | outbound | internal
  type            String    @default("letter")               // letter | email | memo | meeting_minutes | notice | other
  subject         String
  fromName        String    @default("")
  fromOrg         String    @default("")
  toName          String    @default("")
  toOrg           String    @default("")
  cc              String    @default("")                     // comma-separated
  body            String    @default("")
  attachmentsJson String    @default("[]")
  threadId        String?                                    // group related items
  relatedRfiId    String?
  relatedCoId     String?
  status          String    @default("sent")                 // draft | sent | received | acknowledged | escalated
  requiresResponse Boolean  @default(false)
  responseDueDate DateTime?
  respondedAt     DateTime?
  orgId           String?
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId, date])
  @@index([threadId])
}

// ─── Sprint 6: Transmittals (formal document handoff with sign-off) ─────────────
model Transmittal {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number          String    @default("")
  date            DateTime
  subject         String
  purpose         String    @default("for_review")           // for_review | for_approval | for_information | for_record | for_action
  fromName        String    @default("")
  fromOrg         String    @default("")
  toName          String    @default("")
  toOrg           String    @default("")
  cc              String    @default("")
  description     String    @default("")
  documentsJson   String    @default("[]")                   // [{name, revision, fileUrl?, drawingNumber?}]
  dueDate         DateTime?
  status          String    @default("draft")                // draft | sent | acknowledged | actioned | closed
  acknowledgedBy  String    @default("")
  acknowledgedAt  DateTime?
  notes           String    @default("")
  orgId           String?
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId, status])
}

// ─── Sprint 8: Cost-Match AI (BIM element → BOQ position mapping) ───────────────
/// One row per AI-suggested or human-confirmed match between a BIM element
/// and a BOQ position. Used to roll up actual BIM-driven cost without manual
/// takeoff data entry.
model CostMatch {
  id              String       @id @default(uuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bimElementId    String?                                       // optional FK to BimElement
  bimGlobalId     String       @default("")                     // IFC globalId for cross-model lookups
  bimDescription  String       @default("")                     // snapshot of element ifcClass/name/material
  boqId           String?                                       // optional FK to Boq
  boqPositionId   String?                                       // FK to BoqPosition
  matchSource     String       @default("ai")                   // ai | manual | imported
  matchScore      Float        @default(0)                      // 0-1 confidence from AI
  matchReason     String       @default("")                     // AI's rationale
  quantity        Decimal      @default(0) @db.Decimal(18, 4)   // derived quantity from element geometry
  unit            String       @default("")
  confirmedBy     String       @default("")                     // user email who accepted match
  confirmedAt     DateTime?
  status          String       @default("suggested")            // suggested | confirmed | rejected
  orgId           String?
  createdBy       String       @default("")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([projectId, status])
  @@index([projectId, boqPositionId])
}

/// Tracks compliance requirements for a project, pre-seeded with CR
/// regulatory checklists per building type.
model ComplianceRequirement {
  id               String    @id @default(uuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authority        String
  category         String    @default("general")
  title            String
  description      String    @default("")
  requiredBy       String    @default("")
  dueDate          DateTime?
  filedDate        DateTime?
  approvedDate     DateTime?
  expirationDate   DateTime?
  reference        String    @default("")
  responsibleParty String    @default("")
  documentUrl      String    @default("")
  generatedHtml    String    @default("")
  status           String    @default("pending")
  notes            String    @default("")
  orgId            String?
  createdBy        String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, status])
  @@index([authority])
}
