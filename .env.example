# Costaplanner web app
# Copy to .env.local for local dev; configure the same vars on Vercel for prod.

# Shared Neon Postgres — same DATABASE_URL as REVARA so users + designs live in one DB.
DATABASE_URL="postgresql://neondb_owner:REDACTED@ep-still-lake-amat04z5-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# next-auth — MUST match REVARA's secret so JWTs are interchangeable in the future.
NEXTAUTH_URL="https://costaplanner.vercel.app"
NEXTAUTH_SECRET="REDACTED-same-as-REVARA"

# Costaplanner API (Python FastAPI calc engine)
# Renamed from costaplanner.vercel.app to costaplanner-api.vercel.app
# when the web app took that slug.
COSTAPLANNER_API_URL="https://costaplanner-api.vercel.app"
